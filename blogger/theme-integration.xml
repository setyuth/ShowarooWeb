<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<!--
  ShowAroo — full Blogger theme.
  This is a COMPLETE theme file, not a snippet: Blogger → Theme → Edit HTML →
  select-all → paste this in full → Save. It replaces whatever theme is
  currently active on the blog.

  Before saving, update the two placeholders below (search for them):
    - YOUR-BLOG-URL           → your blog's real URL, e.g. https://showaroo.blogspot.com
    - REPLACE_WITH_TMDB_V4_READ_ACCESS_TOKEN → your TMDB v4 read access token

  Everything else (app code, styles) loads from the pinned jsDelivr CDN build
  at setyuth/ShowarooWeb@v1.0.9. A hidden Blog1 widget is kept in <body> only
  because Blogger requires at least one Blog widget to accept/save a theme —
  it is not shown; ShowAroo's own JS app is the entire visible experience.
-->
<html b:css='false' b:js='false' b:responsive='false'
      xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gml/b'
      xmlns:data='http://www.google.com/2005/gml/data'
      xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='UTF-8'/>
  <meta content='width=device-width, initial-scale=1, viewport-fit=cover' name='viewport'/>
  <title><data:blog.pageTitle/></title>

  <!-- Blogger requires this include for feeds, admin bar, and platform scripts to work correctly -->
  <b:include data='blog' name='all-head-content'/>

  <!-- Blogger theme skin block: required by the template schema. ShowAroo's real
       styling comes entirely from the CDN stylesheets below, so this stays minimal. -->
  <b:skin><![CDATA[
    body { margin: 0; padding: 0; }
  ]]></b:skin>

  <!-- ===== ShowAroo integration: head ===== -->
  <link crossorigin='anonymous' href='https://image.tmdb.org' rel='preconnect'/>
  <link crossorigin='anonymous' href='https://api.themoviedb.org' rel='preconnect'/>

  <!-- SEO baseline: static tags crawlers see before JS runs. HeadManager enriches per view at runtime. -->
  <meta content='ShowAroo — discover movies and TV shows.' name='description'/>
  <meta content='ShowAroo' property='og:site_name'/>
  <meta content='website' property='og:type'/>
  <meta content='summary_large_image' name='twitter:card'/>
  <link href='https://showaroo.blogspot.com/' rel='canonical'/>
  <script type='application/ld+json'>
  //<![CDATA[
  {
    "@context": "https://schema.org", "@type": "WebSite", "name": "ShowAroo",
    "url": "https://showaroo.blogspot.com/",
    "potentialAction": { "@type": "SearchAction",
      "target": "https://showaroo.blogspot.com/#/search?q={search_term_string}", "query-input": "required name=search_term_string" }
  }
  //]]>
  </script>

  <!-- Preload the first stylesheet to cut render-blocking latency -->
  <link as='style' href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/tokens.css' rel='preload'/>

  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/reset.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/tokens.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/components/lazyimg.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/motion.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/base.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/layout.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/components/components.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/pages/home.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/pages/search.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/pages/discover.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/pages/detail.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/pages/watch.css' rel='stylesheet'/>
  <link href='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/styles/library.css' rel='stylesheet'/>
</head>
<body>

  <!-- ===== ShowAroo app mount point — this is the entire visible site ===== -->
  <div id='showaroo-app'></div>

  <!-- Hidden Blog1 widget: Blogger will not save a theme that has zero Blog
       widgets, so one lives here for platform compliance. It is never shown
       and never affects ShowAroo's UI. Do not delete this section. -->
  <div aria-hidden='true' style='display:none !important;'>
    <b:section id='showaroo-hidden-blog-section' maxwidgets='1'>
      <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2'>
        <b:includable id='main'>
          <b:loop values='data:posts' var='post'>
            <data:post.body/>
          </b:loop>
        </b:includable>
      </b:widget>
    </b:section>
  </div>

  <!-- ===== ShowAroo integration: pre-</body> ===== -->
  <script>
  //<![CDATA[
    window.__SHOWAROO_ENV__ = {
      mode: 'production',
      debug: false,
      tmdbApiKey: '',
      tmdbAccessToken: 'eyJhbGcxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxiZiI6MTc4NDY5NTIwNy41NjksInN1YiI6IjZhNjA0OWE3MjQ1OWNmZjhiNGMxZjFhOSIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.ye0nnGl01dTl318PUGbFKk8u_7z9y5f_VEwlzc5kwHA',
      cdnBaseUrl: 'https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9',
      siteBaseUrl: 'https://showaroo.blogspot.com'
    };
  //]]>
  </script>
  <script src='https://cdn.jsdelivr.net/gh/setyuth/ShowarooWeb@v1.0.9/src/main.js' type='module'></script>

</body>
</html>